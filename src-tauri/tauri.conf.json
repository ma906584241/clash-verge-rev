{
  "version": "2.6.0",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "homepage": "https://github.com/ma906584241/clash-verge-rev",
    "longDescription": "CraftVPN is a GPL-3.0 modified fork of clash-verge-rev. It is not an official Clash Verge release.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources"],
    "publisher": "CraftVPN",
    "externalBin": ["sidecar/verge-mihomo", "sidecar/verge-mihomo-alpha"],
    "copyright": "GPL-3.0. Modified fork of clash-verge-rev (2026-11-10).",
    "category": "DeveloperTool",
    "shortDescription": "CraftVPN",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "CraftVPN",
  "identifier": "io.github.ma906584241.craftvpn",
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyOUFCNUMxN0E4MEY5NUEKUldUeW1yWEJlb0Q1V3BZQXFKam1UWVlpZWQxQzc1MC94VDdmZWZjWURkS0NPcnRMVDk5M1VvL2oK",
      "endpoints": [
        "https://github.com/ma906584241/clash-verge-rev/releases/download/updater/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["craftvpn"]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": ["desktop-capability", "migrated"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  }
}
